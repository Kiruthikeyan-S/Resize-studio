# Ratio Studio - Environment Configuration
# Copy this file to .env in the backend directory and configure your Groq credentials.
# Never commit the .env file containing private keys to version control.

# Groq Vision API Key for subject categorization and composition analysis
GROQ_API_KEY=

# Studio OpenCV Adaptive Fallback (default: true)
# When set to true and Groq API is unreachable, uses studio adaptive diffusion as an honest labeled fallback.
ALLOW_OPENCV_FALLBACK=true
