# Ratio Studio - Environment Configuration Example
# Copy this file to .env in the backend directory and configure your AI credentials.
# Never commit the .env file containing private keys to version control.

# Groq Vision API Key for subject categorization and composition analysis
GROQ_API_KEY=

# Optional: OpenAI API Key (Official image editing / DALL-E 2 inpainting)
OPENAI_API_KEY=

# Optional: Explicit OpenCV Fallback (default: true)
# When set to true and AI keys are absent or unreachable, allows studio OpenCV adaptive expansion as a labeled fallback.
ALLOW_OPENCV_FALLBACK=true
