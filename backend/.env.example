# Ratio Studio - Environment Configuration Example
# Copy this file to .env in the backend directory and configure your AI credentials.
# Never commit the .env file containing private keys to version control.

# OpenAI API Key (Official image editing / DALL-E 2 inpainting)
# When set, Ratio Studio uses OpenAI to generate seamless expanded backgrounds for commercial products.
OPENAI_API_KEY=

# Google Gemini API Key (Alternative image editing provider)
# When set, Ratio Studio can use Gemini Imagen 3 for background outpainting.
GEMINI_API_KEY=

# Optional: Groq Vision API Key for subject categorization and composition analysis
GROQ_API_KEY=

# Optional: Explicit OpenCV Fallback (default: false)
# When set to true and no AI keys are present or AI fails, allows studio OpenCV texture expansion as a labeled fallback.
# When false (default), missing credentials or provider failure will be accurately reported as "AI Unavailable" or "AI Generation Failed".
ALLOW_OPENCV_FALLBACK=false
