# Ratio Studio - Environment Configuration
# Copy this file to .env in the backend directory and configure your credentials.
# Never commit the .env file containing private keys to version control.

# Groq Vision API Key for subject categorization and composition analysis
GROQ_API_KEY=

# Cloudflare Workers AI Credentials (Free generative AI inpainting)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Studio OpenCV Adaptive Fallback (default: true)
# When set to true and AI APIs are unreachable, uses studio adaptive diffusion as an honest labeled fallback.
ALLOW_OPENCV_FALLBACK=true
