# Ratio Studio - Environment Configuration Example
# Copy this file to .env in the backend directory (or configure keys in backend/.env).
# Never commit the .env file containing private keys to version control.

# Groq Vision API Key (scene analysis and subject categorization)
GROQ_API_KEY=

# Supported Generative AI Outpainting Providers (configure at least one for genuine AI generation):
# 1. OpenAI (Official image editing / inpainting API: gpt-image-1-mini, dall-e-2)
OPENAI_API_KEY=

# 2. Stability AI (Official outpainting API: stable-image/edit/outpaint)
STABILITY_API_KEY=

# 3. Hugging Face Inference Router (SDXL inpainting/outpainting)
HF_TOKEN=

# 4. Google Gemini (Imagen / Gemini multimodal image generation - requires paid AI Studio project)
GEMINI_API_KEY=

# Computer-Vision Scenery Fallback Toggle (default: true)
# When set to true: if AI keys are unconfigured or credit-exhausted, runs multi-scale photographic scenery continuation (no grey bars, zero seam, continuous sky & foliage).
# When set to false: if AI keys are unconfigured or credit-exhausted, returns a clear error instead of generating fallback.
ALLOW_OPENCV_FALLBACK=true
