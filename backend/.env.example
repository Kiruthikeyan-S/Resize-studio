# Ratio Studio - Environment Configuration Example
# Copy this file to .env and insert your API keys if you wish to enable external cloud AI services.
# The application also includes an offline, deterministic OpenCV studio texture & gradient background
# expansion engine that runs automatically without any API keys.

# Optional: Groq Vision API Key for subject categorization and composition suggestions
GROQ_API_KEY=

# Optional: OpenAI API Key for DALL-E 2 inpainting / generative background expansion
OPENAI_API_KEY=

# Optional: Google Gemini API Key for Gemini multimodal image processing
GEMINI_API_KEY=
